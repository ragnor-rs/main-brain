# Copy to e2e/.env.local and fill in. That file is git-ignored; this one is not, so nothing
# here may be a real value.
#
# A real value already in the environment wins over this file, so a one-off export still
# overrides it without an edit.

# The only accepted target. The suite refuses to start without it, because it plants messages
# into a real Telegram account and production ingests into the live corpus.
MB_E2E_TARGET=dev

# From https://my.telegram.org/apps
MB_E2E_API_ID=
MB_E2E_API_HASH=

# From `python3 e2e/login.py`. This is a logged-in account, not a password — treat it as the
# most sensitive line in the file.
MB_E2E_SESSION=

# The assistant bot on the dev stack, once there is one to talk to.
MB_E2E_BOT=

# A counterpart the corpus holds, as you would type it to the bot. Three of the request shapes
# are asked about somebody, and a name the corpus does not know is answered — correctly — with
# the reply that says the subject could not be established, which tests nothing about the
# shape. Left unset those cases skip and say so.
#
# **A contact, and not the name of a conversation.** Two of the three shapes accept a contact
# and nothing else, so a group's name resolves for the one that also accepts a conversation and
# is answered by the other two with the reply offering that conversation's participants as
# candidates — which is the stack working and two cases failing on their fixture. A counterpart
# with history answers all three.
#
# It belongs here rather than in a test because every name in this corpus belongs to a real
# person or organisation, and this repository is not private.
MB_E2E_SUBJECT=
