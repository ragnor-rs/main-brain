{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(gh pr view:*)",
      "Bash(git ls-remote:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/drop-merged-stack.sh\"",
            "if": "Bash(gh pr merge:*)",
            "statusMessage": "Releasing the merged branch's stack and worktree",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
