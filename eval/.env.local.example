# Copy to eval/.env.local and fill in only what you want to override. That file is git-ignored;
# this one is not, so nothing here may be a real value.
#
# **Most of this you do not need.** The store password, the shared secret and the model credential
# are already in the repository's own `.env` for Compose, and this suite reads that file — a second
# copy of any of them is a copy that drifts. What is here is the overrides.
#
# A real value already in the environment wins over both files, so a one-off export still
# overrides without an edit.

# The only accepted target, and the same variable the end-to-end suite reads. The suite refuses to
# start without it: it seeds a fixture corpus and production holds the live one.
MB_E2E_TARGET=dev

# Where the `eval` profile publishes its two services, if the defaults collide with something
# already listening on this machine. They must agree with what `docker-compose.yml` maps.
EVAL_BACKEND_PORT=18080
EVAL_POSTGRES_PORT=5433

# How long a prepared corpus is reused before it is rebuilt. Rebuilding spends the model budget on
# one recognition sweep over the fixtures, so this is the knob between cost and a corpus whose
# future has not slipped into the past.
EVAL_SNAPSHOT_MAX_AGE_HOURS=24

# How long a rebuild waits for the stack to derive the fixtures. Sized against the provider's batch
# turnaround rather than local compute: recognition's classification goes to the batch endpoint,
# which is allowed an hour for most submissions and a day for any. Raising this costs nothing on a
# run that works -- the wait returns as soon as the marks land -- so it is the point at which
# waiting stops being worthwhile, not an estimate of how long deriving takes.
EVAL_DERIVATION_TIMEOUT_SECONDS=5400
